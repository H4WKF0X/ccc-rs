# Copy to ccc.local.toml (git-ignored) for personal settings. Any key from ccc.toml can go here.
#
# downloads_dir = "/home/me/Downloads"
#
# codingcontest.org credentials (platform = "codingcontest"; see docs/PLATFORM.md). They expire.
#
# Option A: the portal cookies. DevTools -> Network -> any codingcontest.org/api request ->
# Request Headers -> Cookie (copy the whole value).
# cookie = "PASTE_COOKIE_HEADER"
#
# Option B: the game's own credentials, from any request to https://<game>.codingcontest.org/api/...
# game_token = "PASTE_AUTHORIZATION_HEADER"
# game_url = "https://spaceship.codingcontest.org"
# contest_slug = "PASTE_X_CCC_SLUG_HEADER"
