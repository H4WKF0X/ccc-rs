{
  "permissions": {
    "allow": [
      "Bash(cargo ccc login:*)",
      "Bash(cargo ccc progress:*)",
      "Bash(cargo ccc fetch:*)",
      "Bash(cargo ccc ingest:*)",
      "Bash(cargo ccc validate:*)",
      "Bash(cargo ccc all:*)",
      "Bash(cargo ccc run:*)",
      "Bash(cargo ccc bench:*)",
      "Bash(cargo ccc status:*)",
      "Bash(cargo ccc new-level:*)",
      "Bash(cargo ccc help:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(cargo fmt:*)",
      "Bash(sh checker/node-safe.sh:*)",
      "Bash(cargo ccc guard:*)",
      "Bash(~/.ccc-venv/bin/python:*)",
      "Bash(~/.ccc-venv/bin/python3:*)",
      "Bash(~/.ccc-venv/bin/pip install:*)",
      "Bash(cargo ccc best:*)"
    ],
    "ask": [
      "Bash(cargo ccc submit:*)"
    ],
    "deny": [
      "Read(./work/*/quarantine/**)",
      "Bash(cargo ccc guard-html:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/notify.sh"
          }
        ]
      }
    ]
  }
}
